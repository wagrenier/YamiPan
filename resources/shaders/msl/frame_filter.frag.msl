#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_FilterUniforms
{
    float4 uArea;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_FilterUniforms& FilterUniforms [[buffer(0)]], texture2d<float> uSource [[texture(0)]], sampler uSourceSampler [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(uSource.sample(uSourceSampler, (in.in_var_TEXCOORD0 * FilterUniforms.uArea.xy)).xyz, FilterUniforms.uArea.z);
    return out;
}

